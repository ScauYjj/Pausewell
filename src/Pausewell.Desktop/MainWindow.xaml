<Window x:Class="Pausewell.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materials="clr-namespace:Pausewell.MaterialLab;assembly=Pausewell.Presentation" Title="间歇 · Windows v0.3.9" Width="1200" Height="900" MinWidth="900" MinHeight="650" WindowStartupLocation="CenterScreen">
 <Grid x:Name="RootView">
  <materials:AmbientScene x:Name="AmbientLayer"/>
  <Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition/></Grid.RowDefinitions>
   <Grid x:Name="NavigationHost"><StackPanel x:Name="NavigationBar" Orientation="Horizontal"/></Grid>
   <Grid x:Name="ReadingHost" Grid.Row="1">
    <DockPanel x:Name="ReadingLayout">
     <Border DockPanel.Dock="Bottom" Margin="0,16,0,0"><TextBlock x:Name="RuntimeLabel" Text="关闭窗口后继续在托盘运行；退出应用后不再提醒。" Foreground="{DynamicResource Muted}" FontSize="12"/></Border>
     <Border x:Name="SchedulerFaultBox" DockPanel.Dock="Top" Background="#FFF0E8" Padding="12" CornerRadius="10" Margin="0,0,0,12" Visibility="Collapsed"><DockPanel><Button DockPanel.Dock="Right" AutomationProperties.AutomationId="RetryScheduling" Content="重试调度" Click="RetryScheduling_Click" Margin="16,0,0,0" VerticalAlignment="Center"/><TextBlock x:Name="SchedulerFaultText" TextWrapping="Wrap" Foreground="#963F30" VerticalAlignment="Center"/></DockPanel></Border>
     <Border x:Name="ErrorBox" DockPanel.Dock="Top" Background="#FFF0E8" Padding="12" CornerRadius="10" Margin="0,0,0,12" Visibility="Collapsed"><TextBlock x:Name="ErrorText" TextWrapping="Wrap" Foreground="#963F30"/></Border>
     <ContentControl x:Name="PageHost" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"/>
    </DockPanel>
   </Grid>
  </Grid>
 </Grid>
</Window>
